{
  "name": "@nnamaka/central",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/supervisor.ts",
    "dev:gateway": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts src/supervisor.ts src/keepalive-once.ts --format esm --target node22 --clean",
    "start": "node dist/index.js",
    "start:all": "node dist/supervisor.js --prod",
    "keepalive": "tsx src/keepalive-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
